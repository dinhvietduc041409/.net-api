{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5434;Database=dfw_api;Username=postgres;Password=postgres"
  },
  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "InstanceName": "dfw:"
    }
  },
  "Jwt": {
    "Issuer": "dfw-api",
    "Audience": "dfw-frontend",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
